# Copy this file to .env and fill in your keys.
# The system works without any keys (RSS feeds only).
# Each tier unlocks faster/richer data.

# ── Tier 1 — WebSocket (< 100 ms latency) ────────────────────────────────────
# Alpaca Markets (free paper-trading account gives you news stream access)
# https://alpaca.markets
ALPACA_KEY=
ALPACA_SECRET=

# ── Tier 3 — REST APIs (poll every 15-60 s) ──────────────────────────────────

# Finnhub — free tier: 60 calls/min, real-time news endpoint
# https://finnhub.io
FINNHUB_KEY=

# NewsAPI — free tier: 100 requests/day, business headlines
# https://newsapi.org
NEWSAPI_KEY=

# Alpha Vantage — free tier: 25 calls/day, news + sentiment scores
# https://www.alphavantage.co
AV_KEY=
